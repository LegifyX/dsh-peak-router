{
  "name": "dsh-peak-router",
  "version": "0.1.0",
  "description": "Peak/off-peak model routing for DeepSeek Harness: at DeepSeek peak pricing, move live sessions to a cheaper route such as deeprelay's DeepSeek-V4.1-Flash, and optionally back off-peak. Skips the swap when the target's remaining quota is nearly spent.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "icon": "icon.svg",
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-credentials": "^0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LegifyX/dsh-peak-router.git"
  },
  "homepage": "https://github.com/LegifyX/dsh-peak-router#readme",
  "bugs": {
    "url": "https://github.com/LegifyX/dsh-peak-router/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "model-routing",
    "peak-pricing",
    "deeprelay"
  ]
}
